table Dataset_Sales
	lineageTag: 873006e6-2dc0-49b5-a658-7c32c6d28ac2

	measure TotRevenue = SUM(Dataset_Sales[ProductPrice])  * SUM(Dataset_Sales[qty])
		lineageTag: bab4af3f-f08a-4e5a-9904-5fb843539112

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotSpent = SUM(Dataset_Sales[CostPrice]) * SUM(Dataset_Sales[qty])
		lineageTag: 8c2d7cf1-ecba-48c6-9e5e-461703290cca

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotDiscount = SUM(Dataset_Sales[discount]) * SUM(Dataset_Sales[qty])
		lineageTag: 1600c4ab-37eb-43ba-b9e9-86bd263f28e1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

	measure TotProfit = [TotRevenue] - [TotSpent] - [TotDiscount]
		lineageTag: e20fd5d8-a345-4348-a597-d1b0b75a4fe1

		annotation PBI_FormatHint = {"isGeneralNumber":true}

