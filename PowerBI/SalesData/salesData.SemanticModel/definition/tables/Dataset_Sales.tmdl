	partition Dataset_Sales = m
		mode: directQuery
		source =
				let
				    Source = Sql.Database("HIMAKARTHIKEYA\KKMSSQL", "Sales", [Query="SELECT C.categoryid,C.categoryname,P.ProductID,P.productname,P.unitprice AS ProductPrice#(lf),OD.OrderID,OD.unitprice AS CostPrice,OD.discount,OD.qty#(lf),CONVERT(DATE,O.orderdate) AS OrderDate,CONVERT(DATE,O.requireddate) AS RequiredDate,CONVERT(DATE,o.shippeddate) AS ShippedDate#(lf)FROM  Production.Categories C#(lf)LEFT JOIN  Production.Products P ON C.categoryid = P.categoryid#(lf)LEFT JOIN Sales.OrderDetails OD ON OD.productid = P.productid#(lf)LEFT JOIN Sales.Orders O ON O.orderid = OD.orderid#(lf)"])
				in
				    Source

	annotation PBI_ResultType = Table

	annotation PBI_NavigationStepName = Navigation

